{
  "name": "yeganehha/digikala-seller-open-api",
  "description": "A typed PHP client for the Digikala Marketplace Open API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Yeganehha\\DigikalaSellerOpenApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yeganehha\\DigikalaSellerOpenApi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
